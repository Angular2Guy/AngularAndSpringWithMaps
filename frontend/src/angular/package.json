{
  "name": "maps",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --hmr --proxy-config proxy.conf.js",
    "build": "ng build --localize --configuration production",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "prebuild": "rimraf ./dist && mkdirp ./dist",
    "postbuild": "npm run deploy",
    "predeploy": "rimraf ../../../backend/src/main/resources/static/*",
    "deploy": "cpy 'base/*' dist/testproject/browser/ && cpy 'dist/testproject/browser/**' ../../../backend/src/main/resources/static/",
    "prettier": "npx prettier --write 'src/**/*.{ts,html,scss,json}'",
    "extract-i18n": "ng extract-i18n --format=json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.1",
    "@angular/cdk": "^22.0.1",
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/localize": "^22.0.1",
    "@angular/material": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/platform-browser-dynamic": "^22.0.1",
    "@angular/router": "^22.0.1",
    "bingmaps": "^2.0.3",
    "material-icons": "^1.11.11",
    "rxjs": "^7.4.0",
    "tslib": "^2.3.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@analogjs/vitest-angular": "^2.6.2",
    "@angular-devkit/build-angular": "^22.0.1",
    "@angular-eslint/builder": "^22.0.0",
    "@angular-eslint/eslint-plugin": "^22.0.0",
    "@angular-eslint/eslint-plugin-template": "^22.0.0",
    "@angular-eslint/schematics": "^22.0.0",
    "@angular-eslint/template-parser": "^22.0.0",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.1",
    "@angular/language-service": "^22.0.1",
    "@types/bingmaps": "^7.0.20",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cpy-cli": "^4.2.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jsdom": "^30.1.2",
    "mkdirp": "^1.0.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.2",
    "ts-node": "~10.4.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "webpack-bundle-analyzer": "^4.5.0"
  }
}
